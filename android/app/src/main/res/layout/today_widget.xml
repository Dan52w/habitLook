<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#151823">
  <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F8F7FB" android:textSize="30sp" android:textStyle="bold" />
  <TextView android:id="@+id/widget_activity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#C9B6E8" android:textSize="16sp" android:textStyle="bold" />
  <TextView android:id="@+id/widget_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#B1B6C5" android:textSize="12sp" />
</LinearLayout>
